#!/usr/bin/env bash
# mw:summary=Adjust monitor brightness over DDC/CI
# mw:args=up | down | set <0-100> | get | list | sdr [up|down|<value>]
# mw:examples=mw-brightness up | mw-brightness set 40 | mw-brightness sdr up
#
# For external monitors: there is no /sys/class/backlight to write to and
# brightnessctl has nothing to act on, so it goes over DDC/CI. Requires the i2c-dev module and membership of the
# i2c group; ddcutil ships the udev rule that grants it.
set -euo pipefail

step="${MW_BRIGHTNESS_STEP:-5}"

# Map the focused Hyprland output to a ddcutil display number via its DRM
# connector, so the keys act on the monitor you are actually looking at.
focused_display() {
  local conn
  conn="$(hyprctl monitors -j 2>/dev/null | jq -r '.[] | select(.focused) | .name')" || true
  [[ -n "$conn" ]] || { echo 1; return; }
  ddcutil detect --brief 2>/dev/null \
    | awk -v want="$conn" '
        /^Display /            { d = $2 }
        /DRM connector:/       { split($3, p, "-"); if (p[2] "-" p[3] == want) { print d; exit } }' \
    | head -1 | grep -E '^[0-9]+$' || echo 1
}

osd() { qs -c mw ipc call osd brightness >/dev/null 2>&1 || true; }

# SDR-in-HDR brightness lives in the monitor config, not in the panel.
hdr_output="${MW_HDR_OUTPUT:-$(hyprctl monitors -j 2>/dev/null | jq -r '.[] | select(.focused) | .name' | head -1)}"
state="${XDG_STATE_HOME:-$HOME/.local/state}/mw"
mkdir -p "$state"
sdr_file="$state/sdrbrightness"

sdr_get() {
  if [[ -s "$sdr_file" ]]; then cat "$sdr_file"; else echo 1.0; fi
}

sdr_set() {
  local v="$1"
  hyprctl eval "hl.monitor({ output = '$hdr_output', mode = 'highres@highrr', position = 'auto', scale = 1, bitdepth = 10, cm = 'hdr', sdrbrightness = $v, sdrsaturation = 1.0, vrr = 0 })" >/dev/null
  printf '%s\n' "$v" > "$sdr_file"
  echo "$v"
}

case "${1-get}" in
  list)
    ddcutil detect --brief 2>/dev/null | grep -E '^Display|DRM connector|Monitor:'
    printf '\nSDR brightness on %s: %s\n' "$hdr_output" "$(sdr_get)"
    ;;

  sdr)
    # A separate control from the panel's own backlight. On an HDR output,
    # SDR content is mapped to a fraction of the panel's range, and this is
    # that fraction — 1.0 is the reference level, higher is brighter. It is
    # what makes an HDR desktop look dim when the hardware is already maxed.
    cur="$(sdr_get)"
    case "${2-get}" in
      get) echo "$cur" ;;
      up)   sdr_set "$(awk -v c="$cur" 'BEGIN{ v=c+0.1; if (v>4) v=4; printf "%.1f", v }')" ;;
      down) sdr_set "$(awk -v c="$cur" 'BEGIN{ v=c-0.1; if (v<0.5) v=0.5; printf "%.1f", v }')" ;;
      *) [[ "${2}" =~ ^[0-9.]+$ ]] || { echo "mw-brightness: sdr needs up, down or a number" >&2; exit 1; }
         sdr_set "$2" ;;
    esac
    ;;
  get)
    ddcutil --display "$(focused_display)" getvcp 10 --brief 2>/dev/null | awk '{print $4}'
    ;;
  up)
    ddcutil --display "$(focused_display)" setvcp 10 + "$step" --noverify 2>/dev/null; osd
    ;;
  down)
    ddcutil --display "$(focused_display)" setvcp 10 - "$step" --noverify 2>/dev/null; osd
    ;;
  set)
    [[ "${2-}" =~ ^[0-9]+$ ]] || { echo "mw-brightness: set needs 0-100" >&2; exit 1; }
    ddcutil --display "$(focused_display)" setvcp 10 "$2" --noverify 2>/dev/null; osd
    ;;
  *) echo "mw-brightness: unknown subcommand: $1" >&2; exit 1 ;;
esac
